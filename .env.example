TRADING_MODE=paper
BITGET_REST_BASE_URL=https://api.bitget.com
BITGET_WS_PUBLIC_URL=wss://ws.bitget.com/v3/ws/public
# Keep collector readiness liveness checks isolated from the full paper symbol universe.
QUANT_COLLECTOR_READINESS_SYMBOLS=BTCUSDT,ETHUSDT
# Phase 9 enabled deployments use a runtime role with no schema DDL privilege.
POSTGRES_DSN=postgresql://quant_app:CHANGE_ME@postgres:5432/quant
# Used only by the explicit maintenance migration command, never by Engine/Collector.
QUANT_MIGRATION_DSN=postgresql://quant_migration:CHANGE_ME@postgres:5432/quant
KLINE_RETENTION_5M_DAYS=30
KLINE_RETENTION_15M_DAYS=90
KLINE_RETENTION_1H_DAYS=180
KLINE_RETENTION_4H_DAYS=365
KLINE_FETCH_LIMIT=100
KLINE_INGESTION_GRACE_5M_SECONDS=30
KLINE_INGESTION_GRACE_15M_SECONDS=60
KLINE_INGESTION_GRACE_1H_SECONDS=120
KLINE_INGESTION_GRACE_4H_SECONDS=180
PHASE4_ENABLED=0
PHASE4_LIQUIDATION_EVENT_RETENTION_HOURS=24
PHASE4_LIQUIDATION_1M_RETENTION_DAYS=7
PHASE4_LIQUIDATION_5M_RETENTION_DAYS=30
PHASE4_LIQUIDATION_15M_RETENTION_DAYS=90
PHASE4_LIQUIDATION_1H_RETENTION_DAYS=180
PHASE4_LIQUIDATION_4H_RETENTION_DAYS=365
PHASE4_LONG_SHORT_RETENTION_DAYS=90
PHASE4_BASIS_RETENTION_DAYS=90
PHASE4_CROSS_EXCHANGE_RETENTION_DAYS=90
PHASE4_ENRICHMENT_RETENTION_DAYS=90
PHASE4_MAX_BASIS_TIMESTAMP_SKEW_SECONDS=5
PHASE4_QUEUE_CAPACITY=2000
# Global collector-safe event and approximate in-memory byte budgets. These
# apply across both public liquidation exchanges and recovery retries.
PHASE4_EVENT_BUDGET=20000
PHASE4_EVENT_BYTES_BUDGET=33554432
PHASE4_BUILDER_WINDOW_BUDGET=20000
PHASE4_FINALIZED_WINDOW_BUDGET=40000
PHASE4_ROLLUP_WINDOW_BUDGET=100000
PHASE4_HYDRATION_WINDOWS_PER_KEY=240
PHASE4_REST_CYCLE_SECONDS=60
PHASE4_BITGET_CLASSIC_REST_BASE_URL=https://api.bitget.com
PHASE4_BITGET_UTA_REST_BASE_URL=https://api.bitget.com
PHASE4_BITGET_UTA_WS_PUBLIC_URL=wss://ws.bitget.com/v3/ws/public
PHASE4_BYBIT_REST_BASE_URL=https://api.bybit.com
PHASE4_BYBIT_WS_PUBLIC_LINEAR_URL=wss://stream.bybit.com/v5/public/linear
PHASE4_HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
PHASE5_ENABLED=0
PHASE5_MIN_CLOSED_BARS=21
PHASE5_RETURN_LOOKBACK_BARS=3
PHASE5_VOL_WINDOW_BARS=20
PHASE5_VOLUME_BASELINE_BARS=20
PHASE5_MIN_UNIVERSE_SAMPLE=20
PHASE5_MIN_BREADTH_COVERAGE=0.80
PHASE5_BREADTH_NEUTRAL_BAND_PCT=0.05
PHASE5_BREADTH_BROAD_RATIO=0.60
PHASE5_BREADTH_NARROW_RATIO=0.55
PHASE5_MIN_SECTOR_MEMBERS=5
PHASE5_MIN_MARKET_BENCHMARK_SAMPLE=20
PHASE5_MAX_CONTEXT_TIMESTAMP_SKEW_SECONDS=60
PHASE5_MAX_EVIDENCE_BYTES=65536
PHASE5_EMA_FAST_PERIOD=9
PHASE5_EMA_SLOW_PERIOD=21
PHASE5_SLOPE_THRESHOLD_PCT=0.10
PHASE5_VOLUME_BELOW_RATIO=0.80
PHASE5_VOLUME_ELEVATED_RATIO=1.50
PHASE5_VOL_LOW_5M=0.0010
PHASE5_VOL_HIGH_5M=0.0040
PHASE5_VOL_EXTREME_5M=0.0080
PHASE5_VOL_LOW_15M=0.0015
PHASE5_VOL_HIGH_15M=0.0060
PHASE5_VOL_EXTREME_15M=0.0120
PHASE5_VOL_LOW_1H=0.0030
PHASE5_VOL_HIGH_1H=0.0120
PHASE5_VOL_EXTREME_1H=0.0250
PHASE5_VOL_LOW_4H=0.0060
PHASE5_VOL_HIGH_4H=0.0250
PHASE5_VOL_EXTREME_4H=0.0500
PHASE5_RS_NEGATIVE_15M_PCT=0.20
PHASE5_RS_POSITIVE_15M_PCT=0.20
PHASE5_RS_NEGATIVE_1H_PCT=0.50
PHASE5_RS_POSITIVE_1H_PCT=0.50
PHASE5_RS_NEGATIVE_4H_PCT=1.00
PHASE5_RS_POSITIVE_4H_PCT=1.00
PHASE5_SECTOR_NEGATIVE_15M_PCT=0.20
PHASE5_SECTOR_POSITIVE_15M_PCT=0.20
PHASE5_SECTOR_NEGATIVE_1H_PCT=0.50
PHASE5_SECTOR_POSITIVE_1H_PCT=0.50
PHASE5_SECTOR_NEGATIVE_4H_PCT=1.00
PHASE5_SECTOR_POSITIVE_4H_PCT=1.00
PHASE5_CONTEXT_RETENTION_5M_DAYS=30
PHASE5_CONTEXT_RETENTION_15M_DAYS=90
PHASE5_CONTEXT_RETENTION_1H_DAYS=180
PHASE5_CONTEXT_RETENTION_4H_DAYS=365
PHASE5_ENRICHMENT_RETENTION_DAYS=30
PHASE5_TAXONOMY_PATH=config/phase5_sector_map.csv
# Phase 7 read-only Chain sources are disabled by default. Endpoints may carry
# provider credentials, so never print them or commit real values.
PHASE7_BITCOIN_RPC_ENABLED=false
PHASE7_BITCOIN_RPC_URL=
PHASE7_BITCOIN_RPC_AUTH_MODE=none
PHASE7_BITCOIN_RPC_USERNAME=
PHASE7_BITCOIN_RPC_PASSWORD=
# Bitcoin-only option: api_key_header requires the local secret below.
PHASE7_BITCOIN_RPC_API_KEY=
PHASE7_BITCOIN_RPC_TIMEOUT_SECONDS=8
PHASE7_BITCOIN_RPC_REQUESTS_PER_SECOND=1
PHASE7_BITCOIN_RPC_MAX_CONCURRENCY=1
# Bitcoin verbosity=2 response cap; bounded, Bitcoin-specific (hard max 64 MiB).
PHASE7_BITCOIN_RPC_MAX_RESPONSE_BYTES=33554432
PHASE7_ETHEREUM_RPC_ENABLED=false
PHASE7_ETHEREUM_RPC_URL=
PHASE7_ETHEREUM_RPC_AUTH_MODE=none
PHASE7_ETHEREUM_RPC_TIMEOUT_SECONDS=8
PHASE7_ETHEREUM_RPC_REQUESTS_PER_SECOND=1
PHASE7_ETHEREUM_RPC_MAX_CONCURRENCY=1
PHASE7_CONTEXT_INTERVAL_SECONDS=60
PHASE7_CONTEXT_LOOKBACK_HOURS=4
PHASE7_CONTEXT_WINDOW_BATCH=16
# Optional operator-reviewed JSON files; blank means labels/whale thresholds are NOT_AVAILABLE.
PHASE7_ADDRESS_LABELS_PATH=/run/quant-phase7-config/address-labels.json
PHASE7_WHALE_THRESHOLDS_PATH=/run/quant-phase7-config/whale-thresholds.json
# Phase 8 is read-only options market context and is disabled by default.
# It uses public Deribit market data only; no API keys or private routes are supported.
PHASE8_OPTIONS_ENABLED=false
PHASE8_OPTIONS_MAX_EXPIRY_DAYS=90
PHASE8_OPTIONS_MAX_ABS_MONEYNESS_PCT=5
PHASE8_OPTIONS_MAX_TICKER_INSTRUMENTS_PER_CURRENCY=64
PHASE8_OPTIONS_MAX_TICKER_SUBSCRIPTIONS_TOTAL=128
PHASE8_OPTIONS_MAX_FULL_CHAIN_RECORDS_PER_UNDERLYING=2048
PHASE8_OPTIONS_MAX_FULL_CHAIN_RECORDS_TOTAL=4096
PHASE8_OPTIONS_MAX_MARKPRICE_CHANNELS_TOTAL=4
PHASE8_OPTIONS_INSTRUMENT_REFRESH_SECONDS=86400
PHASE8_OPTIONS_RESEED_AFTER_OUTAGE_SECONDS=300
PHASE8_OPTIONS_CHAIN_SNAPSHOT_INTERVAL_SECONDS=3600
PHASE8_OPTIONS_MARKPRICE_SNAPSHOT_INTERVAL_SECONDS=900
PHASE8_OPTIONS_TICKER_SNAPSHOT_INTERVAL_SECONDS=900
PHASE8_OPTIONS_CONTEXT_INTERVAL_SECONDS=900
PHASE8_OPTIONS_MAX_REST_RESPONSE_BYTES=8388608
PHASE8_OPTIONS_REST_TIMEOUT_SECONDS=10
PHASE8_OPTIONS_REST_MIN_INTERVAL_SECONDS=1.25
PHASE8_OPTIONS_REST_MAX_COOLDOWN_SECONDS=300
PHASE8_OPTIONS_REST_MAX_ATTEMPTS=3
PHASE8_OPTIONS_WS_QUEUE_MAX_MESSAGES=256
PHASE8_OPTIONS_WS_MAX_QUEUED_BYTES=16777216
PHASE8_OPTIONS_WS_MAX_MESSAGE_BYTES=1048576
PHASE8_OPTIONS_WS_SUBSCRIBE_MIN_INTERVAL_SECONDS=0.35
PHASE8_OPTIONS_WS_SUBSCRIBE_BATCH_SIZE=32
PHASE8_OPTIONS_WS_MAX_RECONNECT_ATTEMPTS=8
PHASE8_OPTIONS_WS_RECONNECT_MAX_DELAY_SECONDS=60
PHASE8_OPTIONS_SHUTDOWN_TIMEOUT_SECONDS=10
PHASE8_OPTIONS_SNAPSHOT_RETENTION_DAYS=7
PHASE8_OPTIONS_CONTEXT_RETENTION_DAYS=30
PHASE8_OPTIONS_LIFECYCLE_RETENTION_DAYS=90
PHASE8_OPTIONS_RETENTION_ENFORCEMENT=false
PHASE8_OPTIONS_RETENTION_DELETE_BATCH_ROWS=1000
PHASE8_OPTIONS_CHAIN_STALE_AFTER_SECONDS=5400
PHASE8_OPTIONS_TICKER_STALE_AFTER_SECONDS=300
PHASE8_OPTIONS_MARKPRICE_STALE_AFTER_SECONDS=900
PHASE8_OPTIONS_CATALOG_STALE_AFTER_SECONDS=93600
PHASE8_OPTIONS_LIFECYCLE_STALE_AFTER_SECONDS=60
PHASE8_OPTIONS_MAX_SOURCE_SKEW_SECONDS=5400
PHASE8_OPTIONS_MIN_CHAIN_COVERAGE=0.95
PHASE8_OPTIONS_MIN_TICKER_COVERAGE=0.90
PHASE8_OPTIONS_CONCENTRATION_TOP_N=20
PHASE8_OPTIONS_SKEW_MIN_CONTRACTS=6
PHASE8_OPTIONS_SKEW_MIN_DISTINCT_STRIKES=3
# Leave unset until the source delta scale is verified.
PHASE8_OPTIONS_RR_DELTA_TOLERANCE=

# Phase 9 is disabled until a separately approved policy manifest is installed.
PHASE9_ENABLED=0
PHASE9_MAX_INFLIGHT_EVALUATIONS=2
PHASE9_MAX_QUEUED_IDS=32
PHASE9_MAX_QUEUED_BYTES=8388608
PHASE9_EVALUATION_TIMEOUT_SECONDS=30
PHASE9_MAX_CONCURRENT_JEV_CALLS=1
PHASE9_MAX_REVALIDATIONS_PER_MINUTE=16
PHASE9_CODE_VERSION=
PHASE9_POLICY_MANIFEST_PATH=policies/phase9_policy_v1.json
PHASE9_POLICY_APPROVAL_PATH=policies/phase9_policy_v1.approval.json
